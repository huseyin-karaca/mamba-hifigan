+            in_channels=ch, 
+            out_channels=1, 
+            kernel_size=7, 
+            stride=1, 
+            padding=3,
+            bias=conv_post_bias
+        ))
+        
+        if cond_channels > 0:
+            self.cond_layer = weight_norm(nn.Conv1d(cond_channels, upsample_initial_channel, 1))
+
+        # Ağırlıkları başlat
+        self.apply(init_weights)
+
+    def forward(self, x, g=None):
