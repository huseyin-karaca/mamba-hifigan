+        # ResBlock Tipi
+        resblock = ResBlock1 if resblock_type == "1" else ResBlock2
+
+        # 1. Initial Convolution (Saf PyTorch)
+        self.conv_pre = weight_norm(nn.Conv1d(
+            in_channels=in_channels,
+            out_channels=upsample_initial_channel,
+            kernel_size=7,
+            stride=1,
+            padding=3
